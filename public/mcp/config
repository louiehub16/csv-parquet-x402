{
  "mcp": true,
  "protocol_version": "2024-11-05",
  "service_id": "csv-to-parquet-stream-compressor",
  "tools": [
    {
      "name": "compress_csv_stream",
      "description": "Accept a .csv/.tsv/.txt file and receive a compressed Apache Parquet file. Results below 10 GiB (10737418240 bytes) are written to provider R2 temp storage (24-hour lifecycle) and are NOT returned as a presigned link: the response carries `download_via`, a controlled result endpoint, because a presigned query string is itself a bearer credential. GET /v1/compress/result?ref=... with the same PAYMENT-SIGNATURE header used to pay returns the storage coordinates, and reading the object needs authorized S3/R2 access. Inputs >= 10 GiB require an S3-compatible target_destination supplied by the caller. First call without payment returns HTTP 402 with a PAYMENT-REQUIRED manifest (x402 v2, exact USDC amount on Base); settle and retry with the PAYMENT-SIGNATURE header.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "The CSV/TSV/TXT payload to compress"
          },
          "target_destination": {
            "type": "string",
            "description": "Optional JSON string describing an S3-compatible destination; required for inputs >= 10 GiB"
          }
        },
        "required": [
          "file"
        ]
      }
    }
  ]
}
