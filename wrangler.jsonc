{
  // LABEL: csv-parquet-x402 gateway — Cloudflare Worker (x402 v2 seller)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "csv-parquet-compressor",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "SECURITY_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  // SpendGuard's atomic budget ledger (budget.js) routes through this DO.
  // The ConsumedTxStore class is exported from src/replay-store.js.
  "durable_objects": {
    "bindings": [
      { "name": "CONSUMED_TX_STORE", "class_name": "ConsumedTxStore" }
    ]
  },
  // R46: the internal output bucket. After a durable receipt exists AND the
  // EIP-712 payer has been verified against it, the gateway STREAMS the object
  // to that customer -- so a result in provider storage is actually
  // retrievable (previously they received only bucket+key, which they have no
  // credentials for). No presigned URL and no S3 credentials are involved.
  // bucket_name MUST match R2_BUCKET_NAME, which the engine writes with.
  "r2_buckets": [
    {
      "binding": "RESULTS",
      "bucket_name": "REPLACE_WITH_R2_BUCKET_NAME"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConsumedTxStore"] }
  ],
  "vars": {
    // Public config only — secrets go via `wrangler secret put`:
    //   RUNPOD_API_KEY, RUNPOD_ENDPOINT_URL,
    //   ENGINE_API_KEY (R74: gateway-only bearer the ENGINE enforces; anyone
    //     with the RunPod URL would otherwise convert for free),
    //   R2_ENDPOINT_URL, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME,
    //   CDP_API_KEY_ID, CDP_API_KEY_SECRET (facilitator verify/settle;
    //   cdp.js reads CDP_API_KEY_SECRET)
    // R62: the bucket this Worker is bound to. Result retrieval streams only when
    // the receipt names THIS bucket; a BYO job's object lives in the caller's own
    // bucket and must be fetched with their own credentials. This value MUST
    // match r2_buckets[RESULTS].bucket_name and R2_BUCKET_NAME (engine side).
    "RESULTS_BUCKET_NAME": "REPLACE_WITH_R2_BUCKET_NAME",
    // SpendGuard knobs (hardcoded fallbacks live in src/spendguard.js):
    "SG_MIN_BALANCE": "2.00",
    // Ceiling matches the max internal-tier price for a single file (10 GiB @ $0.10/GB = $1.00)
    "SG_MAX_JOB_COST": "1.00",
    "SG_CPU_RATE_PER_HR": "0.13",
    // Merchant wallet (public address — safe as a var; never put private keys here)
    "MERCHANT_WALLET_ADDRESS": "0x795dCA28d0e8a0E5d19D689163f125a7da1D0B83"
  },
  "observability": { "enabled": true }
}
